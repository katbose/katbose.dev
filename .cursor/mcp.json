{
  "mcpServers": {
    "cloudflare-api": {
      "url": "https://mcp.cloudflare.com/mcp",
      "disabled": false,
      "autoApprove": [
        "search",
        "execute",
        "docs"
      ]
    },
    "cloudflare-bindings": {
      "url": "https://bindings.mcp.cloudflare.com/mcp",
      "disabled": false,
      "autoApprove": [
        "workers_list",
        "kv_namespaces_list",
        "r2_buckets_list",
        "r2_bucket_create"
      ]
    },
    "cloudflare-builds": {
      "url": "https://builds.mcp.cloudflare.com/mcp",
      "disabled": false,
      "autoApprove": [
        "workers_list",
        "workers_builds_get_build",
        "workers_builds_get_build_logs",
        "workers_builds_list_builds",
        "workers_get_worker"
      ]
    },
    "cloudflare-observability": {
      "url": "https://observability.mcp.cloudflare.com/mcp",
      "disabled": false,
      "autoApprove": []
    },
    "cloudflare-docs": {
      "url": "https://docs.mcp.cloudflare.com/mcp",
      "disabled": false,
      "autoApprove": [
        "search_cloudflare_documentation"
      ]
    },
    "github": {
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}"
      },
      "disabled": false,
      "autoApprove": [
        "create_pull_request",
        "pull_request_read",
        "list_pull_requests",
        "list_branches",
        "get_me",
        "list_commits",
        "create_pull_request"
      ]
    },
    "mintlify-admin": {
      "url": "https://mcp.mintlify.com",
      "disabled": false,
      "autoApprove": []
    },
    "mintlify-search": {
      "url": "https://mintlify.com/docs/mcp",
      "disabled": false,
      "autoApprove": [
        "search_mintlify",
        "query_docs_filesystem_mintlify"
      ]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@1.8.0",
        "--isolated",
        "--no-usage-statistics",
        "--no-performance-crux",
        "--redact-network-headers"
      ],
      "disabled": false,
      "autoApprove": [
        "list_pages"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.79",
        "--isolated",
        "--headless",
        "--browser",
        "chrome"
      ],
      "disabled": false,
      "autoApprove": [
        "browser_tabs"
      ]
    },
    "posthog": {
      "url": "https://mcp.posthog.com/mcp",
      "disabled": false,
      "autoApprove": [
        "exec"
      ]
    },
    "sentry": {
      "url": "https://mcp.sentry.dev/mcp",
      "disabled": false,
      "autoApprove": [
        "find_organizations",
        "find_projects",
        "search_sentry_tools",
        "execute_sentry_tool"
      ]
    }
  }
}
