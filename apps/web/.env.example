# Public canonical URL used for metadata and absolute links.
NEXT_PUBLIC_SITE_URL=https://example.com
# Server-only Supabase project REST URL.
SUPABASE_URL=https://project-ref.supabase.co
# Secret: server-only privileged Supabase key; never use a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
# Server-only Payload CMS API base URL.
CMS_URL=https://cms.example.com
# Secret shared by content sync, reconciliation, and revalidation endpoints.
WEBHOOK_SHARED_SECRET=replace-with-32-byte-secret
# Secret for one-time Payload preview links.
PREVIEW_URL_SECRET=replace-with-32-byte-secret
# Secret for Worker-to-CMS draft reads.
PREVIEW_INTERNAL_SECRET=replace-with-32-byte-secret
# Secret HMAC-SHA-256 key for visitor IP pseudonyms.
IP_PSEUDONYM_KEY=replace-with-32-byte-secret
# Non-secret epoch incremented whenever the IP pseudonym key rotates.
IP_PSEUDONYM_EPOCH=replace-with-current-epoch
# Server-only Upstash Redis REST endpoint for rate limiting.
UPSTASH_REDIS_REST_URL=https://example.upstash.io
# Secret Upstash Redis REST token.
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-token
# Public Turnstile widget site key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace-with-turnstile-site-key
# Secret Turnstile server-side siteverify key.
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret-key
# Public PostHog project key.
NEXT_PUBLIC_POSTHOG_KEY=replace-with-posthog-project-key
# Public PostHog ingestion host.
NEXT_PUBLIC_POSTHOG_HOST=https://example.posthog.com
# Server-only Sentry error-reporting DSN.
SENTRY_DSN=https://public-key@example.ingest.sentry.io/project-id
# Secret Sentry token used only for source-map uploads at build time.
SENTRY_AUTH_TOKEN=replace-with-sentry-auth-token
# Secret Slack webhook for operational alerts.
SLACK_ALERTS_WEBHOOK_URL=https://hooks.slack.com/services/replace/me
# Secret Slack webhook for contact-form notifications.
SLACK_CONTACT_WEBHOOK_URL=https://hooks.slack.com/services/replace/me
# Public fallback address displayed when the contact form fails closed.
CONTACT_FALLBACK_EMAIL=person@example.com
# Public plain outbound Cal.com booking link.
NEXT_PUBLIC_CAL_LINK=https://cal.com/example/meet
