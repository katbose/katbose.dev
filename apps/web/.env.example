# katbose.dev — web app (Cloudflare Workers via OpenNext)
#
# Copy to .env.local for local development. .env.local is gitignored and must
# never be committed. Production values live only in Cloudflare Worker secret
# bindings — see docs/17-env-vars.md for the canonical inventory, owner surface
# and rotation policy for every variable below.
#
# Placeholder convention: anything still reading `replace-with-...` is unset.
# Generate 256-bit secrets with:  openssl rand -hex 32
#
# Anything prefixed NEXT_PUBLIC_ is compiled into the browser bundle. Treat it
# as printed on a billboard. The Supabase service role key, preview secrets and
# pseudonym key must never carry that prefix.

# --- Site identity -----------------------------------------------------------
# Canonical origin. Drives metadata, canonical URLs, sitemap and agent outputs.
NEXT_PUBLIC_SITE_URL=https://katbose.dev

# --- Supabase (server-only) --------------------------------------------------
# Project REST URL from Project Settings > API. Region: Mumbai (ap-south-1).
SUPABASE_URL=https://replace-with-project-ref.supabase.co
# Bypasses every RLS policy. Server-only, read solely by lib/supabase/service.ts.
# Leaking this compromises the entire data layer (docs/05-security.md 5.3).
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key

# --- Payload CMS (Phase 2) ---------------------------------------------------
# Payload API base on Render. Unused until Phase 2 content work begins.
CMS_URL=https://cms.katbose.dev
# Authenticates content-sync, reconciliation and Payload-triggered revalidation.
WEBHOOK_SHARED_SECRET=replace-with-32-byte-hex-secret
# Gates one-time Payload preview links. Rotate quarterly.
PREVIEW_URL_SECRET=replace-with-32-byte-hex-secret
# Authenticates Worker-to-CMS draft reads. Rotate quarterly.
PREVIEW_INTERNAL_SECRET=replace-with-32-byte-hex-secret

# --- Visitor pseudonymisation (server-only) ----------------------------------
# HMAC-SHA-256 key for IP pseudonyms. Exists only on the production Worker,
# never on Render — only the Worker sees trusted CF-Connecting-IP (decision #72).
IP_PSEUDONYM_KEY=replace-with-32-byte-hex-secret
# Non-secret epoch stored beside each pseudonym. Increment on every key
# rotation; never correlate values across epochs.
IP_PSEUDONYM_EPOCH=1

# --- Upstash Redis (server-only) ---------------------------------------------
# REST endpoint, not the redis:// protocol URL. Backs contact rate limiting,
# which fails closed when unreachable (docs/07-rate-limiting.md 7.2).
UPSTASH_REDIS_REST_URL=https://replace-with-database-name.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-rest-token

# --- Turnstile ---------------------------------------------------------------
# Invisible widget bound to katbose.dev (add localhost for local development).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace-with-turnstile-site-key
# Server-side siteverify key. The contact route fails closed without it.
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret-key

# --- PostHog (cookieless) ----------------------------------------------------
# Runs memory-only with session replay and person identification disabled.
# Enabling either would invalidate the no-cookie-banner analysis in
# docs/14-privacy-and-compliance.md 14.2 and requires updating that doc first.
NEXT_PUBLIC_POSTHOG_KEY=replace-with-posthog-project-key
# EU Cloud keeps the GDPR posture simple; US Cloud is https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- Sentry ------------------------------------------------------------------
# Server-only error reporting DSN with URL secret redaction enabled.
SENTRY_DSN=https://replace-with-public-key@o0.ingest.sentry.io/0
# Build-time source-map upload only. Never shipped to the browser.
SENTRY_AUTH_TOKEN=replace-with-sentry-auth-token

# --- Slack alerting ----------------------------------------------------------
# Operational alerts channel: #katbose-alerts
SLACK_ALERTS_WEBHOOK_URL=https://hooks.slack.com/services/replace/with/alerts-webhook
# Contact submissions channel: #contact-form. Deliberately separate so real
# leads are never buried in monitoring noise.
SLACK_CONTACT_WEBHOOK_URL=https://hooks.slack.com/services/replace/with/contact-webhook

# --- Public contact surfaces -------------------------------------------------
# Shown when the contact form fails closed. Must be a deliverable address —
# set up Cloudflare Email Routing to forward it.
CONTACT_FALLBACK_EMAIL=im@katbose.dev
# Plain outbound booking link. Never an embedded SDK (decision #47).
NEXT_PUBLIC_CAL_LINK=https://cal.com/katbose/meet
