# katbose.dev — web app (Cloudflare Workers via OpenNext)
#
# Copy to .env.local for local development. .env.local is gitignored and must
# never be committed. docs/17-env-vars.md is the canonical inventory.
#
# Generate 256-bit secrets with:  openssl rand -hex 32
# Anything still reading `replace-with-...` is unset.
#
# ---------------------------------------------------------------------------
# HOW TO READ THE TAGS:  [ where · type · exposure ]
# ---------------------------------------------------------------------------
#
# WHERE — two different places in the Cloudflare dashboard, not one:
#
#   build    Workers & Pages > katbose-web > Settings > Builds
#            > "Variables and secrets"
#            Available while `next build` runs. Every NEXT_PUBLIC_ value is
#            compiled into the client bundle here, and any value read by a
#            statically prerendered page is baked in at this point too.
#            Setting these at runtime instead has NO effect — the bundle was
#            already built without them.
#
#   runtime  Workers & Pages > katbose-web > Settings
#            > "Runtime variables and secrets"
#            Read per request by Route Handlers and server modules.
#
# TYPE — the dropdown when you add an entry (Variable / Secret / JSON):
#
#   variable  plaintext, visible in the dashboard afterwards
#   secret    encrypted at rest, write-only in the dashboard
#
# EXPOSURE:
#
#   public       ships to the browser; assume it is printed on a billboard
#   server-only  never reaches client code
#
# NOT-YET-WIRED entries are documented but no code reads them yet. Leave them
# unset until their phase; the app degrades deliberately without them.

# --- Site identity -----------------------------------------------------------
# [build · variable · public] Canonical origin for canonicals, metadataBase,
# sitemap.xml, robots.txt, JSON-LD, RSS, /agent and /llms.txt. Read by
# apps/web/lib/site-url.ts, which falls back to SITE_IDENTITY.siteUrl when this
# is unset, so leaving it blank is valid for the production build. Set it on a
# fork or staging build so those outputs stop pointing at katbose.dev. Must be
# absolute and https, or the build fails rather than emit a wrong canonical.
NEXT_PUBLIC_SITE_URL=https://katbose.dev

# --- Supabase ----------------------------------------------------------------
# [runtime · variable · server-only] Read by lib/supabase/service.ts and the
# /media/original proxy. Not a credential, but never exposed to the browser.
SUPABASE_URL=https://replace-with-project-ref.supabase.co
# [runtime · secret · server-only] Bypasses every RLS policy. Read only by
# lib/supabase/service.ts. Leaking it compromises the entire data layer
# (docs/05-security.md 5.3). Never give this a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key

# --- Payload CMS -------------------------------------------------------------
# [runtime · variable · server-only] NOT-YET-WIRED — Phase 2.
CMS_URL=https://cms.katbose.dev
# [runtime · secret · server-only] NOT-YET-WIRED — Phase 2. Authenticates
# content sync, reconciliation and Payload-triggered revalidation.
WEBHOOK_SHARED_SECRET=replace-with-32-byte-hex-secret
# [runtime · secret · server-only] NOT-YET-WIRED — Phase 2. Gates one-time
# preview links. Rotate quarterly.
PREVIEW_URL_SECRET=replace-with-32-byte-hex-secret
# [runtime · secret · server-only] NOT-YET-WIRED — Phase 2. Authenticates
# Worker-to-CMS draft reads. Rotate quarterly.
PREVIEW_INTERNAL_SECRET=replace-with-32-byte-hex-secret

# --- Visitor pseudonymisation ------------------------------------------------
# [runtime · secret · server-only] HMAC-SHA-256 key read by lib/security/ip.ts.
# Lives only on the production Worker — only it sees a trusted
# CF-Connecting-IP header (decision #72). Rotate quarterly.
IP_PSEUDONYM_KEY=replace-with-32-byte-hex-secret
# [runtime · variable · server-only] Non-secret epoch stored beside each
# pseudonym. Increment on every key rotation; never correlate across epochs.
IP_PSEUDONYM_EPOCH=1

# --- Upstash Redis -----------------------------------------------------------
# [runtime · variable · server-only] REST endpoint, not the redis:// URL.
UPSTASH_REDIS_REST_URL=https://replace-with-database-name.upstash.io
# [runtime · secret · server-only] Read by lib/rate-limit/contact.ts, which
# fails closed when Upstash is unreachable (docs/07-rate-limiting.md 7.2).
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-rest-token

# --- Turnstile ---------------------------------------------------------------
# [build · variable · public] Rendered by the explicit non-interactive widget
# on /contact and baked into the static client build. Server-side siteverify
# requires action "contact" and the exact hostname from NEXT_PUBLIC_SITE_URL.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace-with-turnstile-site-key
# [runtime · secret · server-only] Read by lib/security/turnstile.ts for
# server-side siteverify. The contact route fails closed without it; never put
# this value in a NEXT_PUBLIC_* variable.
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret-key

# --- PostHog -----------------------------------------------------------------
# [build · variable · public] Read by the client analytics provider, so it must
# exist at build time or PostHog silently never initialises.
NEXT_PUBLIC_POSTHOG_KEY=replace-with-posthog-project-key
# [build · variable · public] Read twice at build time: by the analytics
# provider, and by next.config.ts to add this origin to the CSP connect-src.
# A wrong or missing value means analytics requests are blocked by CSP.
# EU Cloud keeps the GDPR posture simple; US Cloud is https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- Sentry ------------------------------------------------------------------
# [runtime · variable · server-only] Read by sentry.server.config.ts.
SENTRY_DSN=https://replace-with-public-key@o0.ingest.sentry.io/0
# [build · variable · public] Read by instrumentation-client.ts, so it must
# exist at build time or browser errors are never reported. A DSN only permits
# event submission, which is why exposing this one is safe while the runtime
# copy above stays server-only. next.config.ts also reads it at build time to
# add the ingest origin to the CSP connect-src.
NEXT_PUBLIC_SENTRY_DSN=https://replace-with-public-key@o0.ingest.sentry.io/0
# [build · secret · server-only] Source-map upload. Build-time only; never
# shipped to the browser. Rotate quarterly.
SENTRY_AUTH_TOKEN=replace-with-sentry-auth-token
# [build · variable · server-only] Sentry organisation slug. Source-map upload
# and release association are skipped unless the token, org and project are all
# set, so an unconfigured build stays identical to today's output.
SENTRY_ORG=replace-with-sentry-org-slug
# [build · variable · server-only] Sentry project slug. See SENTRY_ORG.
SENTRY_PROJECT=replace-with-sentry-project-slug

# --- Slack -------------------------------------------------------------------
# [runtime · secret · server-only] NOT-YET-WIRED — operational alerts channel
# #katbose-alerts. A webhook URL is a credential: anyone holding it can post.
SLACK_ALERTS_WEBHOOK_URL=https://hooks.slack.com/services/replace/with/alerts-webhook
# [runtime · secret · server-only] Read by lib/monitoring/slack.ts. Channel
# #contact-form, deliberately separate so leads are not buried in alerts.
SLACK_CONTACT_WEBHOOK_URL=https://hooks.slack.com/services/replace/with/contact-webhook

# --- Public contact surfaces -------------------------------------------------
# [build · variable · public] Read by /contact, which is statically prerendered
# — so this is baked in at build time, not read per request. Shown when the
# form fails closed, so it must be a deliverable address; set up Cloudflare
# Email Routing to forward it.
CONTACT_FALLBACK_EMAIL=im@katbose.dev
# [build · variable · public] Read by the Home contact section and /contact,
# both statically prerendered. A plain outbound link, never an embedded SDK
# (decision #47).
NEXT_PUBLIC_CAL_LINK=https://cal.com/katbose/meet
